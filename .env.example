# ==========================================
# NAMOZ SARHISOBI TELEGRAM BOT KONFIGURATSIYASI
# ==========================================

# 1. Telegram Bot Token (@BotFather'dan olingan)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# 2. Admin Telegram ID'lari (vergul bilan ajratilgan)
ADMIN_IDS=123456789

# 3. Ma'lumotlar bazasi (DATABASE_URL yoki DB_PATH):
# ----------------------------------------------------
# Variant A (Railway PostgreSQL - TAVSIYA ETILADI):
# Railway PostgreSQL qo'shilganda DATABASE_URL avtomatik to'ldiriladi:
# DATABASE_URL=postgresql://postgres:password@host:port/railway

# Variant B (Railway Persistent Volume bilan SQLite):
# DATABASE_URL bo'sh qoldirilib, DB_PATH sozlanadi:
# DB_PATH=/app/data/namoz.db

# Lokal test uchun (SQLite):
# DATABASE_URL=sqlite+aiosqlite:///data/namoz.db

# 4. Namoz vaqtlari API (namoz-vaqti.uz)
NAMOZ_API_BASE_URL=https://namoz-vaqti.uz/index.php

# 5. Vaqt mintaqasi (O'zbekiston uchun)
TIMEZONE=Asia/Tashkent

# 6. Ehson bo'limi (Ixtiyoriy)
EHSON_ENABLED=true
EHSON_CHANNEL_URL=https://t.me/namoz_sarhisobi_ehson
EHSON_TEXT=Loyiha xolis niyatda ishlab chiqildi. To'plangan mablag'lar xizmat xarajatlariga sarflanadi.

# 7. Majburiy kanal a'zoligi (Ixtiyoriy, agar kerak bo'lmasa bo'sh qoldiring)
REQUIRED_CHANNEL_ID=
REQUIRED_CHANNEL_URL=
